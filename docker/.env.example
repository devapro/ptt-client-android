# Copy to `.env` in this directory and customize.
#
# This file is auto-loaded by `docker compose` when you run it directly, and
# also sourced by start.sh before it invokes compose. Leave a variable blank
# (or remove the line) to fall back to the default applied by the start script.

# ─── Credentials ──────────────────────────────────────────────────────────
# omp supports many providers. Pass direct API keys through env, or leave
# blank to use omp's interactive OAuth login (persisted under /home/node/.omp).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
PERPLEXITY_API_KEY=
EXA_API_KEY=
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
ZAI_API_KEY=
# Fallback GitHub tokens — used when ~/.config/gh stores the token in the
# system keyring rather than hosts.yml.
GH_TOKEN=
GITHUB_TOKEN=

# ─── Host paths (bind mounts) ─────────────────────────────────────────────
# Set this to your home directory. On Linux: /home/<username>, on Mac: /Users/<username>.
HOST_HOME=/home/YOUR_USER

# Where Oh My Pi persists provider logins, model config, sessions, and caches.
# Point this at your host omp home to reuse provider authorization in Docker.
# A named volume is used when unset, so a fresh container starts logged out.
OMP_DOCKER_HOME=${HOST_HOME}/.omp

# GitHub CLI config on the host (shared with host `gh` CLI by default).
GH_CONFIG_HOME=${HOST_HOME}/.config/gh

# ─── Container architecture ──────────────────────────────────────────────
# amd64 (default) or arm64.
#
# amd64 is native on Intel Macs and Linux. On Apple Silicon it is emulated:
# fine under Rosetta, slower under Docker's QEMU fallback.
#
# arm64 runs natively on Apple Silicon — no emulation, faster Gradle/JVM —
# but Robolectric/Roborazzi tests are excluded by the gradle init script,
# because Robolectric publishes no native runtime for linux/aarch64. Run
# those on the macOS host or in CI.
#
# Each arch uses its own image tag and its own Gradle/omp cache volumes.
# OMP_ARCH=arm64

# Gradle heap cap applied inside the omp container via _JAVA_OPTIONS. The
# project's gradle.properties asks for -Xmx4096m, which fits a default Docker
# VM; raise this if you gave Docker Desktop more memory and want full heap.
# OMP_JVM_HEAP=4g
# OMP_JVM_METASPACE=768m

# Container resource caps. Unset means unlimited: the container may use the
# entire Docker VM. A parallel Gradle build pins every core the VM has, so
# Docker Desktop showing ~100% x <VM CPUs> is expected, not a misconfiguration.
# Set these only if you want to keep host headroom during builds.
#
# Pick OMP_CPUS relative to YOUR machine — your VM's CPU count minus 1-2.
# It must NOT exceed that count: the daemon then refuses to start the container
# ("range of CPUs is from 0.01 to N.00"). Check with `docker info | grep CPUs`.
# OMP_CPUS=8
# OMP_MEM_LIMIT=32g

# Gradle worker cap inside the container, applied via GRADLE_OPTS
# (-Dorg.gradle.workers.max), which outranks gradle.properties in both the
# project and GRADLE_USER_HOME. Unset means Gradle picks based on CPU count.
# Only worth setting together with OMP_CPUS: too many workers oversubscribe a
# capped cgroup, so they contend instead of parallelising. Start at or just
# below OMP_CPUS. The repo's gradle.properties is never modified.
# OMP_GRADLE_WORKERS=6

# ─── Host ADB bridge (optional) ────────────────────────────────────────────
# To reach a host emulator/device over ADB, run `./docker/start.sh --with-adb`.
# It bridges the host adb server (127.0.0.1:5037) into the container:
#   - Linux: starts an adb-proxy sidecar (socat, host net) on 0.0.0.0:5038,
#     and sets ADB_PORT=5038. (Recent platform-tools refuses non-loopback
#     binds, so `adb -a` alone can't expose the server.)
#   - macOS: `adb -a` binds 0.0.0.0:5037 and ADB_PORT=5037 is used directly.
# ADB_HOST_GATEWAY overrides the host address (default host.docker.internal,
# which the extra_hosts entry maps to host-gateway on Linux).
# ADB_PORT=5038
# ADB_HOST_GATEWAY=host.docker.internal
